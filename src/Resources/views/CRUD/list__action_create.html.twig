{% if admin.hasAccess('create') and admin.hasRoute('create') %}
    {% set button_content = sonata_config.getOption('list_action_button_content') %}
    <a
         href="{{ admin.generateUrl('create') }}"
        class="btn btn-sm btn-default create_link"
        title=" {{ 'link_action_create'|trans({}, 'SonataAdminBundle') }}"
    >
        {% if button_content == 'icon' or button_content == 'all' %}
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
        {% endif %}
        {% if button_content == 'text' or button_content == 'all' %}
           {{ 'link_action_create'|trans({}, 'SonataAdminBundle') }}
        {% else %}
            <span class="sr-only">
                {{ 'link_action_create'|trans({}, 'SonataAdminBundle') }}
            </span>
        {% endif %}
    </a>
{% endif %}